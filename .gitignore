# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Editor and operating system noise
.DS_Store
*.swp
*~
/.idea/
/.vscode/

# Bundler. `.bundle/config` is versioned on purpose: it pins the install path so
# a clone, a CI job and the autonomous loop all resolve the same dependency tree.
/.bundle/*
!/.bundle/config
/vendor/bundle/

# Environment files. The versioned example (.env.example) is the only exception,
# and it must never contain a real value.
/.env
/.env.*
!/.env.example

# Credentials. Opanel takes its configuration from the environment, so these
# files should not exist; the rules stay as a guardrail against reintroducing them.
/config/master.key
/config/credentials/*.key

# Logs and temporary files
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids/
/tmp/pids/*
!/tmp/pids/.keep

# Node and Vite build output
/node_modules/
/public/vite*
/public/assets/

# Test, coverage and browser-automation artifacts
/coverage/
/tmp/test-results/
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# Autonomous Development Loop evidence. Evidence is raw command output that is
# regenerated by re-running the checks; only the reports and reviews are versioned.
/docs/implementation/*/evidence/

# Database dumps and backups are never versioned (Annex I 13.2).
# Scoped to dump extensions on purpose: a blanket *.sql would also hide
# db/structure.sql and legitimate fixtures.
*.dump
*.sql.gz
/db/*.sql
!/db/structure.sql

# Vite Ruby
/public/vite*
node_modules
# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vitejs.dev/guide/env-and-mode.html#env-files
*.local

