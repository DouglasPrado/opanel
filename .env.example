# Opanel — environment configuration
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file is versioned and
# must never contain a real value. The secret scan runs over it, and over the
# branch history.
#
# Every key below is declared in lib/opanel/configuration.rb, which validates them
# at boot. A missing required key aborts the process with exit code 78 and names
# the key — it never falls back to a permissive default, and it never prints the
# value it received.
#
# Credentials come from the environment. Opanel has no encrypted credentials file
# and no master key: an unused master key in a workspace is exactly the secret the
# autonomous-loop guardrails forbid (Annex H §3.2).

# --- Required outside development and test ---------------------------------

# Signs cookies and message verifiers. At least 32 characters.
# Generate with: bin/rails secret
SECRET_KEY_BASE=

# --- Database ---------------------------------------------------------------
# Required in production; locally every one of these has a safe default.

OPANEL_DATABASE_HOST=localhost
OPANEL_DATABASE_PORT=5432
# Defaults per environment in config/database.yml (opanel_development, opanel_test, opanel_ci).
OPANEL_DATABASE_NAME=
# Blank locally means the operating-system user.
OPANEL_DATABASE_USERNAME=
OPANEL_DATABASE_PASSWORD=
# Defaults to RAILS_MAX_THREADS.
OPANEL_DATABASE_MAX_CONNECTIONS=
# Seconds a request waits for a connection before failing deterministically.
OPANEL_DATABASE_CHECKOUT_TIMEOUT=5

# --- Web --------------------------------------------------------------------

RAILS_MAX_THREADS=3

# --- Jobs -------------------------------------------------------------------

# Worker processes for the deployments and runtime queues.
OPANEL_JOB_CONCURRENCY=1
# fork or async. Left blank, bin/jobs chooses by platform — see the script for why.
OPANEL_JOB_SUPERVISOR_MODE=
OPANEL_JOB_HEARTBEAT_INTERVAL_SECONDS=60
OPANEL_JOB_ALIVE_THRESHOLD_SECONDS=300

# --- Outbox Dispatcher and Recovery Sweep (M01-14) ---------------------------

# Maximum number of outbox events to publish in one dispatcher run.
OPANEL_OUTBOX_DISPATCHER_BATCH_SIZE=100
# How often the outbox dispatcher publishes pending events to the queue (seconds).
OPANEL_OUTBOX_DISPATCHER_CADENCE_SECONDS=5
# Maximum number of stalled operations to recover per sweep run.
OPANEL_RECOVERY_SWEEP_BATCH_SIZE=50
# How often the recovery sweep checks for stalled operations (seconds).
OPANEL_RECOVERY_SWEEP_CADENCE_SECONDS=30
# How long a RUNNING operation may go without heartbeat before marked stalled (seconds).
OPANEL_RECOVERY_SWEEP_HEARTBEAT_THRESHOLD_SECONDS=600
# How long a QUEUED operation may wait before marked stalled (seconds).
OPANEL_RECOVERY_SWEEP_QUEUED_THRESHOLD_SECONDS=300
# Number of unpublished events that triggers backpressure (deferral of new operations).
OPANEL_QUEUE_BACKPRESSURE_HIGH_WATER_MARK=1000
# How long to defer operation enqueue when queue backpressure is active (seconds).
OPANEL_QUEUE_BACKPRESSURE_DELAY_SECONDS=60
