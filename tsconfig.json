{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node", "vitest/globals"],

    // `strict` matches the strictness the imported component library (M00-05) is
    // written against. `exactOptionalPropertyTypes` and `noUncheckedIndexedAccess`
    // are off, and that is an exception rather than a preference: it is recorded
    // in config/quality/waivers.yml with an owner, a risk, a mitigation and a
    // date, and `bin/suppression-gate` fails when either the waiver is missing or
    // it has expired. A comment here justifying it — which is what used to be
    // here — has no owner and no expiry, so nothing ever comes back on.
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,

    "paths": {
      "@/*": ["./app/frontend/*"]
    }
  },
  "include": [
    "app/frontend/**/*.ts",
    "app/frontend/**/*.tsx",
    "spec/frontend/**/*.ts",
    "spec/frontend/**/*.tsx",
    "e2e/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "public", "vendor", "tmp", "app/frontend/.lint-probe"]
}
