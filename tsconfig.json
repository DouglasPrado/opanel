{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    // `strict` matches the strictness the imported component library (M00-05) is
    // written against. `exactOptionalPropertyTypes` and `noUncheckedIndexedAccess`
    // are deliberately absent: turning them on would require rewriting the
    // library's prop types, and M00-05 forbids redesigning an imported
    // component's API. Raising them again means fixing the library upstream, in
    // a Story of its own.
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,

    "paths": {
      "@/*": ["./app/frontend/*"]
    }
  },
  "include": ["app/frontend/**/*.ts", "app/frontend/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules", "public", "vendor", "tmp", "app/frontend/.lint-probe"]
}
