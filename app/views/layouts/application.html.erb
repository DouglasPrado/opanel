<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Opanel" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Opanel">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# React Refresh must be installed before the Vite client, or @vitejs/plugin-react
        cannot find its preamble and every module fails to evaluate — the page loads
        and React never mounts. It is a no-op outside development. %>
    <%= vite_react_refresh_tag %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag "application.tsx" %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
