#!/usr/bin/env ruby
# frozen_string_literal: true

# The single command that turns a clone into a working environment.
#
#   bin/setup                # install, prepare, and start bin/dev
#   bin/setup --skip-server  # stop before starting anything
#   bin/setup --reset        # drop and recreate the databases first
#
# Two properties matter more than what it installs:
#
#   * **It is idempotent.** Running it twice leaves the same state and exits 0.
#     A setup script people are afraid to re-run is a setup script that rots.
#   * **A missing prerequisite fails early and says which one and which version.**
#     The failure mode this replaces is a stack trace forty lines into a bundle
#     install that means "you do not have PostgreSQL".

require "English"
require "json"

APP_ROOT = File.expand_path("..", __dir__)
Dir.chdir(APP_ROOT)

options = ARGV
RESET = options.include?("--reset")
SKIP_SERVER = options.include?("--skip-server")

BOLD = "\e[1m"
RED = "\e[31m"
GREEN = "\e[32m"
DIM = "\e[2m"
RESET_COLOR = "\e[0m"

def step(title)
  puts "\n#{BOLD}== #{title}#{RESET_COLOR}"
end

def ok(message)
  puts "  #{GREEN}✓#{RESET_COLOR} #{message}"
end

def note(message)
  puts "  #{DIM}#{message}#{RESET_COLOR}"
end

# Every failure says what is wrong *and* what to do about it. A setup script that
# only says "failed" hands the problem back unchanged.
def fail_with(problem, remedy)
  warn "\n#{RED}#{BOLD}bin/setup failed#{RESET_COLOR}"
  warn "  #{problem}"
  warn "\n  #{BOLD}To fix:#{RESET_COLOR} #{remedy}\n\n"
  exit 1
end

def run!(command, problem:, remedy:)
  return if system(command)

  fail_with(problem, remedy)
end

def command_available?(name)
  system("command -v #{name} > /dev/null 2>&1")
end

def version_of(command, pattern)
  output = `#{command} 2>&1`
  output[pattern, 1]
end

# --- No production credential in the workspace ------------------------------
# First, before anything is installed or connected. If this machine holds a
# production credential, nothing else should run here at all (Annex H §3.2).

step "Checking the workspace"

unless system("bin/workspace-guardrail")
  fail_with(
    "A production credential was found in this workspace.",
    "Remove it from the environment or the file named above, and rotate it — a credential " \
    "that reached a workspace is compromised, not merely misplaced (Annex H §3.2)."
  )
end
ok "no production credential"

# --- Prerequisites -----------------------------------------------------------

step "Checking prerequisites"

required_ruby = File.read(".ruby-version").strip.delete_prefix("ruby-")
unless Gem::Version.new(RUBY_VERSION) >= Gem::Version.new("3.2.0")
  fail_with(
    "Ruby #{RUBY_VERSION} is too old. Opanel needs Ruby >= 3.2 (this repository pins #{required_ruby}).",
    "Install it with your version manager, e.g. `rbenv install #{required_ruby}`."
  )
end
ok "Ruby #{RUBY_VERSION}"

# One declaration of the Node contract, read here and by
# .github/actions/setup — a second copy is how CI and a developer machine end up
# on different majors, which presents as a flaky build and is not one.
required_node = JSON.parse(File.read("package.json")).dig("engines", "node").to_s[/(\d+)/].to_i

unless command_available?("node")
  fail_with("Node.js is not installed.",
    "Install Node.js #{required_node} or newer, e.g. `brew install node`.")
end

node_major = version_of("node --version", /v(\d+)/).to_i
if node_major < required_node
  fail_with(
    "Node.js #{node_major} is too old. The Vite toolchain needs Node #{required_node} or newer " \
    "(package.json `engines.node`).",
    "Upgrade Node.js, e.g. `brew upgrade node` or `nvm install #{required_node}`."
  )
end
ok "Node.js #{version_of('node --version', /v([\d.]+)/)}"

unless command_available?("npm")
  fail_with("npm is not installed.", "It ships with Node.js — reinstall Node.js.")
end

unless command_available?("psql")
  fail_with(
    "The PostgreSQL client is not installed.",
    "Install PostgreSQL 16 or newer, e.g. `brew install postgresql@17`."
  )
end

# The client existing says nothing about the server running, and "connection
# refused" thirty seconds later is a worse message than this one.
unless system("pg_isready > /dev/null 2>&1")
  fail_with(
    "PostgreSQL is installed but not accepting connections.",
    "Start it, e.g. `brew services start postgresql@17`, then run bin/setup again."
  )
end
ok "PostgreSQL is accepting connections"

# --- Dependencies ------------------------------------------------------------

step "Installing dependencies"

unless system("bundle check > /dev/null 2>&1")
  run!("bundle install",
    problem: "`bundle install` failed.",
    remedy: "Read the output above. A native extension usually means a missing system library.")
end
ok "gems"

# `npm ci` is the reproducible install; it needs the lockfile to match
# package.json, which is exactly the property we want enforced.
if Dir.exist?("node_modules") && system("npm ls --depth=0 > /dev/null 2>&1")
  ok "npm packages (already installed)"
else
  run!("npm ci --no-audit --no-fund",
    problem: "`npm ci` failed.",
    remedy: "If package.json and package-lock.json disagree, run `npm install` once and commit the lockfile.")
  ok "npm packages"
end

# --- Database ----------------------------------------------------------------

step "Preparing the database"

if RESET
  run!("bin/rails db:drop", problem: "Could not drop the databases.",
    remedy: "Close anything still connected — a `rails console`, a running server, a `psql` session.")
  note "dropped"
end

run!("bin/rails db:prepare",
  problem: "`db:prepare` failed.",
  remedy: "Check that PostgreSQL is running and that OPANEL_DATABASE_* point at it. See .env.example.")
ok "development"

run!("RAILS_ENV=test bin/rails db:prepare",
  problem: "`db:prepare` failed for the test database.",
  remedy: "Check that PostgreSQL is running and that the test database name is free.")
ok "test"

# One database per parallel worker, so `bin/test --parallel` works without a
# second setup step nobody remembers.
#
# `parallel:create` + `parallel:load_schema` rather than `parallel:prepare`: the
# latter purges the *base* test database, which fails whenever anything is
# connected to it — an open console, a running server — and would make this step
# print a warning on most invocations for no reason.
if system("bundle exec rake parallel:create parallel:load_schema > /dev/null 2>&1")
  ok "parallel test workers"
else
  note "parallel test databases not prepared — run `bundle exec rake parallel:create parallel:load_schema` " \
       "before `bin/test --parallel`"
end

step "Seeding development data"

run!("bin/rails db:seed",
  problem: "Seeding failed.",
  remedy: "Seeds are idempotent; read the error above, it is a real failure.")
ok "seeds (synthetic; no real data)"

# --- Git hooks ---------------------------------------------------------------

step "Installing git hooks"

if File.exist?("bin/install-hooks")
  run!("bin/install-hooks", problem: "Could not install the git hooks.",
    remedy: "Check that .git/hooks is writable.")
  ok "pre-commit"
else
  note "hook installer not present yet (delivered by M00-12)"
end

# --- Done --------------------------------------------------------------------

step "Ready"
puts <<~SUMMARY
    #{GREEN}#{BOLD}Opanel is set up.#{RESET_COLOR}

      #{BOLD}bin/dev#{RESET_COLOR}          start the web server, the job worker and Vite
      #{BOLD}bin/test#{RESET_COLOR}         run the backend suite
      #{BOLD}bin/gate local#{RESET_COLOR}   run the local quality gate before committing

    Configuration comes from the environment. Copy .env.example to .env to override
    a default; nothing in it is required for development.
SUMMARY

exit 0 if SKIP_SERVER

step "Starting bin/dev"
$stdout.flush
exec "bin/dev"
