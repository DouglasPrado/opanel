#!/usr/bin/env bash
# Security scan: secrets, dependencies, static analysis.
#
#   bin/security                 # everything
#   bin/security --fast          # secret scan only — what the pre-commit gate runs
#   bin/security --staged        # scan the staged diff — what the pre-commit gate runs
#   bin/security --diff          # scan the files changed since the merge base — for the local gate
#   bin/security --history       # also scan the branch history
#   bin/security --waivers       # list waivers and what is about to expire
#   bin/security --format json
#
# Policy (Annex C §21.1, Annex D §17.1):
#
#   * A **secret** blocks, always. A secret that reached the repository is
#     compromised and needs rotation, not a `git rm`.
#   * A **new Critical or High** in a dependency or in static analysis blocks.
#   * Medium and Low are reported and tracked.
#   * A finding is silenced only by a waiver with an owner and an expiry, and an
#     expired waiver blocks again automatically. See config/security/waivers.yml.
#
# **The report never prints the secret it found** — file, line and rule only.
set -uo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
source bin/_gate_lib.sh

format="text"
mode="all"
history="no"
scope="all"
out=""

while [ $# -gt 0 ]; do
  case "$1" in
    --fast) mode="fast" ;;
    --staged) scope="staged" ;;
    --diff) scope="diff" ;;
    --history) history="yes" ;;
    --waivers) mode="waivers" ;;
    --out) out="$2"; shift ;;
    --out=*) out="${1#--out=}" ;;
    --format) format="$2"; shift ;;
    --format=*) format="${1#--format=}" ;;
    --json) format="json" ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

if [ "$mode" = "waivers" ]; then
  exec bin/security-waivers --format "$format"
fi

# Where each scanner's own machine-readable output is kept.
#
# The report used to be built from this gate's check list: one entry per tool,
# `severity: blocking`. That is a description of the run, not of what was found —
# it cannot say which advisory, in which package, at which severity, so nothing
# downstream can count Critical and High. Annex D §24 asks for findings and their
# severities, so the scanners' own results are preserved and parsed.
SCANNER_DIR="tmp/security/scanners"
mkdir -p "$SCANNER_DIR"

# The Security Report of Annex D §24, written from this run rather than from a
# second one. `finish` is called instead of `gate_finish` everywhere below, so an
# early exit still archives what it found.
finish() {
  if [ -n "$out" ]; then
    if ! gate_write_json "$out"; then
      gate_fail "report" "the gate result could not be written to $out"
    elif ! ruby lib/gates/security_report.rb "$out" > /dev/null; then
      gate_fail "report" "the security report could not be written to $out"
      # The file on disk still says the run passed. Rewrite it, or the archived
      # evidence disagrees with the exit code — which is the class of defect
      # this whole file exists to remove.
      gate_write_json "$out" || true
    fi
  fi
  gate_finish
}

gate_begin "security" "$format"

# --- Waivers -----------------------------------------------------------------
# First: a malformed or expired waiver is itself a finding, and the scanners
# below consult the same file.
gate_run "waivers" bin/security-waivers --check

# Every allowlist entry carries a written reason. An unexplained one is
# indistinguishable from a real secret somebody hid (M00-10 AC4).
gate_run "allowlist" ruby lib/gates/secret_allowlist.rb

# --- Secrets -----------------------------------------------------------------
# gitleaks is a binary rather than a gem. Its absence is a setup failure and must
# say so — a secret scan that silently does not run is worse than none.
if ! command -v gitleaks > /dev/null 2>&1; then
  gate_fail "secret-scan" "gitleaks is not installed. Install it (brew install gitleaks) — a secret scan that does not run is not a pass."
else
  # ## What the scanner scans, and why it is not the checkout
  #
  # `gitleaks dir .` walks the filesystem. This checkout is 952 MB —
  # `node_modules/` 484, `log/` 181, `vendor/` 151, `tmp/` 108 — and **13 MB,
  # 1 047 files, is what git can commit**. Scanning the other 98,6% cost 79 s on
  # every run and could not find a leak that matters: a file git ignores cannot
  # be committed, so it cannot leak by this path.
  #
  # So the scope is the **committable set**: what git tracks, plus what is
  # untracked and not ignored (a pasted credential lands in a new file before
  # anyone runs `git add`). It is derived from git's own ignore rules, never
  # from a path list here or in `gitleaks.toml` — if `node_modules/` stopped
  # being ignored it would be scanned again, with nothing to change. That is the
  # difference between narrowing a scanner and excluding a directory from it.
  #
  # The set is copied into a directory and scanned by **one** `gitleaks`
  # process. `gitleaks dir` takes a single path, and the first version of
  # `--diff` ran one process per file: 1 047 processes, 18 s, nearly all of it
  # spawn. The copy is 13 MB and costs a fraction of a second.
  #
  # `--staged` (pre-commit: "is there a secret in what I am about to commit?")
  # and `--history` stay in `gitleaks git` mode, which reads objects and never
  # walked the checkout in the first place. **CI still scans the tree and the
  # history**: the scope moves, the check does not (Annex I §21.2).
  scan_set() {
    # One `local` per name: bash expands every word of a `local` before it
    # assigns any of them, so `report="…/$name.json"` on the same line reads an
    # unset `name` and, under `set -u`, aborts the scan.
    local name="$1"
    # **Outside the repository, on purpose.** `gitleaks dir` honours the
    # `.gitignore` of the repository it finds itself in, so a copy under `tmp/`
    # — which this repository ignores — is scanned as ~0 bytes: 1 049 files
    # present, nothing read, "no leaks found" in 381µs. That is a scanner that
    # passes because it looked at nothing, and the `--diff` negative in
    # spec/security/security_scan_spec.rb is what caught it.
    local root
    root="$(mktemp -d "${TMPDIR:-/tmp}/opanel-scan-XXXXXX")"
    local report="$SCANNER_DIR/$name.json"
    local status=0
    local output

    # Copy the listed files, keeping their paths. Ruby rather than `tar -T`
    # because it filters what the list can legitimately contain and the copy
    # cannot: a tracked file deleted in the working tree, and a symlink (git
    # stores its target as content; following it would leave the tree).
    if ! ruby -rfileutils -e '
      root = ARGV[0]
      FileUtils.rm_rf(root)
      FileUtils.mkdir_p(root)
      # NUL only. The first version also split on "\n", and a newline inside a
      # file name — a byte git tracks perfectly well — cut the path into pieces
      # that matched no file, so the file was copied nowhere and scanned by
      # nobody. The independent review planted a secret in such a file and the
      # scan reported PASS while the old `gitleaks dir .` found it. Every
      # producer below emits -z for this reason.
      $stdin.read.split("\0").each do |path|
        next if path.empty? || File.symlink?(path) || !File.file?(path)

        destination = File.join(root, path)
        FileUtils.mkdir_p(File.dirname(destination))
        FileUtils.cp(path, destination)
      end
    ' "$root"; then
      echo "could not assemble the set to scan" >&2
      return 1
    fi

    output="$(gitleaks dir "$root" \
      --config config/security/gitleaks.toml \
      --redact \
      --no-banner \
      --report-format json \
      --report-path "$report" \
      --exit-code 1 2>&1)" || status=$?

    # A finding names the file by its path in the repository, not by the copy's.
    printf '%s\n' "$output" | sed "s|$root/||g"
    [ -f "$report" ] && ruby -e 'File.write(ARGV[0], File.read(ARGV[0]).gsub(ARGV[1] + "/", ""))' "$report" "$root"
    rm -rf "$root"

    return $status
  }

  # Everything git can commit, NUL-delimited so a path with a space or a quote
  # survives. The two lists cannot overlap: `--others` is exactly the untracked.
  committable_set() {
    git ls-files -z
    git ls-files --others --exclude-standard -z
  }

  if [ "$scope" = "diff" ]; then
    # The local gate asks a narrower question — "is there a secret in what I
    # changed?" — over the same committable set. `gate_files changed` is the
    # tracked diff plus the index; a **new** file is neither until it is added,
    # and the first version of this scope missed exactly that (the negative in
    # spec/security/security_scan_spec.rb planted a secret in an untracked file
    # and the scan passed).
    # Straight from git, NUL-delimited, rather than through `gate_files`: that
    # helper is newline-based and every caller of it treats a line as a path,
    # which is exactly the assumption that lost a file above. `--diff-filter`
    # keeps added, copied, modified and renamed and drops deletions, which have
    # nothing left to scan.
    diff_base="$(bin/story-scope base 2>/dev/null || true)"
    [ -n "$diff_base" ] || diff_base="$(git merge-base HEAD "${OPANEL_GATE_BASE:-main}" 2>/dev/null || echo HEAD)"
    diff_count="$({ git diff --name-only -z --diff-filter=ACMR "$diff_base"; \
      git ls-files --others --exclude-standard -z; } | tr -cd '\0' | wc -c | tr -d ' ')"
    if [ "$diff_count" = "0" ]; then
      gate_skip "secret-scan-diff" "nothing changed since the Story's base"
    else
      scan_diff() {
        { git diff --name-only -z --diff-filter=ACMR "$diff_base"
          git ls-files --others --exclude-standard -z
        } | scan_set "gitleaks-diff"
      }
      gate_run "secret-scan-diff" scan_diff
    fi
  elif [ "$scope" = "staged" ]; then
    gate_run "secret-scan-staged" gitleaks git --staged . \
      --config config/security/gitleaks.toml \
      --redact \
      --no-banner \
      --report-format json \
      --report-path "$SCANNER_DIR/gitleaks.json" \
      --exit-code 1
  else
    scan_tree() { committable_set | scan_set "gitleaks"; }
    gate_run "secret-scan" scan_tree
  fi

  if [ "$history" = "yes" ]; then
    # The history matters as much as the tree: a secret removed in a later commit
    # is still in the history, and still compromised.
    gate_run "secret-scan-history" gitleaks git . \
      --config config/security/gitleaks.toml \
      --redact \
      --no-banner \
      --report-format json \
      --report-path "$SCANNER_DIR/gitleaks-history.json" \
      --exit-code 1
  fi
fi

if [ "$mode" = "fast" ]; then
  finish
fi

# --- Dependencies ------------------------------------------------------------

# Annex I §10: a dependency added without a recorded justification is refused,
# and an unpinned one resolves differently on every machine. Before the
# advisories, because "should this be here at all" comes before "is this version
# vulnerable".
gate_run "dependency-gate" ruby bin/dependency-gate

gate_run "bundler-audit" bundle exec bundle-audit check --update \
  --config config/bundler-audit.yml \
  --format json --output "$SCANNER_DIR/bundler-audit.json"

# npm audit exits non-zero for any severity; --audit-level makes the policy
# explicit rather than accidental. The structured result is captured separately,
# because the exit code says whether anything blocked and nothing about what.
capture_npm_audit() {
  npm audit --json > "$SCANNER_DIR/npm-audit.json" 2>/dev/null
  npm audit --audit-level=high
}
gate_run "npm-audit" capture_npm_audit

# --- Static analysis ---------------------------------------------------------
# Informative in M00 (there is almost no code for it to judge yet), blocking for
# new Critical/High from M01. `--no-exit-on-warn` is what makes it informative,
# and removing it is the one-line change that flips the policy.

# Two outputs, formats inferred from the destinations: the JSON is the evidence
# the report parses, the text is what a person reads in the log.
gate_run "brakeman" bundle exec brakeman --quiet --no-pager --no-exit-on-warn \
  --output "$SCANNER_DIR/brakeman.json" \
  --output /dev/stdout

finish
