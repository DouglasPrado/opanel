#!/usr/bin/env ruby
# frozen_string_literal: true

# Suppression Gate (Annex I §21.2): a silenced rule has to name the Story or ADR
# that allows it.
#
#   bin/suppression-gate                 # every tracked file
#   bin/suppression-gate <path>...       # only these
#   bin/suppression-gate --format json

require "json"
require_relative "../lib/gates/control_reductions"
require_relative "../lib/gates/suppression_gate"

format = "text"
paths = []
arguments = ARGV.dup

until arguments.empty?
  argument = arguments.shift

  case argument
  when "--json" then format = "json"
  when "--format" then format = arguments.shift
  when /\A--format=(.+)\z/ then format = Regexp.last_match(1)
  when /\A--/
    warn "unknown option: #{argument}"
    exit 2
  else
    paths << argument
  end
end

unless %w[text json].include?(format)
  warn "unknown format: #{format.inspect} (expected text or json)"
  exit 2
end

root = File.expand_path("..", __dir__)

# A control turned down in a *configuration* file leaves no suppression comment
# to find, so it is checked separately: an ESLint rule switched off for a
# directory, a tsconfig flag left out, an accessibility violation baselined. Each
# needs an owned, dated waiver in config/quality/waivers.yml.
#
# Only on the whole-repository run. Given explicit paths this command answers a
# question about those files, and a repository-wide finding would be an answer to
# something nobody asked.
whole_repository = paths.empty?

if whole_repository
  Dir.chdir(root) { paths = `git ls-files`.split("\n") }
  paths = paths.map { |path| File.join(root, path) }
end

SKIPPED = %r{
  /(node_modules|vendor|public|tmp|log)/            # not our code
  | \.(png|jpg|jpeg|gif|svg|woff2?|ico|lock|pdf)\z  # not text
  | \.md\z                                          # prose: an example suppresses nothing
}x

# The gate's own source and its negative-case fixtures contain the patterns by
# definition — one as regular expressions, the other as planted violations.
# Scanning them would report the checker for being a checker.
#
# This list is exactly that: adding to it is editing a gate, which the Post-commit
# Gate flags and which needs a Story of its own (Annex I §21.2).
SELF_REFERENTIAL = %w[
  lib/gates/suppression_gate.rb
  spec/gates/lint_rules_spec.rb
].freeze

paths = paths.select do |path|
  next false unless File.file?(path)
  next false if path.match?(SKIPPED)

  relative = path.delete_prefix("#{root}/")
  !SELF_REFERENTIAL.include?(relative)
end

started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
violations = Opanel::Gates::SuppressionGate.check_paths(paths)
violations += Opanel::Gates::ControlReductions.new(root).violations if whole_repository
duration = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started

relative = ->(path) { path.start_with?(root) ? path.delete_prefix("#{root}/") : path }

if format == "json"
  puts JSON.pretty_generate(
    check: "suppression-gate",
    result: violations.empty? ? "pass" : "fail",
    duration_ms: (duration * 1000).round,
    files_checked: paths.length,
    rules: {
      Opanel::Gates::SuppressionGate::RULE => Opanel::Gates::SuppressionGate::RULE_DESCRIPTION,
      Opanel::Gates::ControlReductions::RULE => Opanel::Gates::ControlReductions::RULE_DESCRIPTION
    },
    violations: violations.map { |violation| violation.to_h.merge(file: relative.call(violation.file)) }
  )
elsif violations.empty?
  puts "suppression-gate: PASS (#{paths.length} file(s), #{(duration * 1000).round}ms)"
else
  violations.each do |violation|
    puts "suppression-gate: FAIL [#{violation.rule}] #{relative.call(violation.file)}:#{violation.line}"
    puts "  #{violation.message}"
    puts "  remedy: #{violation.remedy}"
  end
  puts "suppression-gate: #{violations.length} unjustified suppression(s)"
end

exit(violations.empty? ? 0 : 1)
