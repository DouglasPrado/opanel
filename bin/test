#!/usr/bin/env bash
# Backend suite: RSpec against real PostgreSQL.
#
#   bin/test                       # every type
#   bin/test --type integration    # one type: unit|integration|request|policy|contract|security
#   bin/test --parallel            # one database per worker
#   bin/test --changed             # only the specs that differ from the merge base
#   bin/test --fast                # skip :slow examples — what the pre-commit gate runs
#   bin/test --seed 12345          # reproduce an ordering failure
#   bin/test --format json         # gate-shaped output
#   bin/test spec/integration/...  # a path
#
# Order is random and the seed is reported, so a spec that depends on execution
# order fails here rather than in CI three weeks later — and the failure is
# reproducible with --seed.
#
# Every run writes tmp/test-results/rspec.xml (JUnit) and rspec-metadata.json
# naming the commit, the branch, the environment, the type and the duration. A
# test result without that is not release evidence (Annex D §24).
set -uo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
source bin/_gate_lib.sh

format="text"
parallel="no"
scope="all"
fast="no"
force="no"
type="all"
paths=""
seed=""

while [ $# -gt 0 ]; do
  case "$1" in
    --type) type="$2"; shift ;;
    --type=*) type="${1#--type=}" ;;
    --parallel) parallel="yes" ;;
    --changed) scope="changed" ;;
    --force) force="yes" ;;
    --fast) fast="yes" ;;
    --seed) seed="$2"; shift ;;
    --format) format="$2"; shift ;;
    --format=*) format="${1#--format=}" ;;
    --json) format="json" ;;
    --*) echo "unknown option: $1" >&2; exit 2 ;;
    *) paths="$paths $1" ;;
  esac
  shift
done

if [ "$type" != "all" ]; then
  type_paths="$(ruby lib/gates/suite_types.rb "$type")" || exit 2
  paths="$paths $type_paths"
fi

if [ "$scope" = "changed" ] && [ -z "${paths// /}" ]; then
  # The *related* tests, not the changed spec files (Annex I §11.1). Selecting
  # only changed specs meant a commit touching nothing but source ran nothing and
  # the gate recorded `tests PASS` — the shape of commit where running the suite
  # matters most was the shape where none ran.
  #
  # Ruby under app/ or lib/ that no spec covers exits non-zero here rather than
  # selecting nothing: "there was nothing to run" and "everything passed" are not
  # the same answer.
  if ! paths="$(bin/story-scope specs)"; then
    exit 1
  fi
  paths="$(printf '%s' "$paths" | tr '\n' ' ')"
  if [ -z "${paths// /}" ]; then
    echo "bin/test: no backend spec is related to the change"
    exit 0
  fi
fi

mkdir -p tmp/test-results

# Every invocation is its own run, with its own JUnit files.
#
# Deliberately regenerated rather than inherited: the gate suites spawn nested
# `bin/test` runs against planted failures, and with one shared filename the
# child's report overwrote the parent's — so a full run's evidence became a
# one-example probe's, and the numbers no longer described the run that produced
# them.
OPANEL_TEST_RUN_ID="$$-$(date +%s)"
export OPANEL_TEST_RUN_ID
rm -f "tmp/test-results/rspec-$OPANEL_TEST_RUN_ID"*.xml

# The JUnit formatter is configured in spec_helper so every parallel worker writes
# to its own file instead of overwriting one.
export OPANEL_JUNIT=1

# --fast drops the `:slow` examples — the gate suites, which shell out to
# RuboCop, gitleaks and RSpec itself against planted failures. The Pre-commit
# Gate uses it to stay inside its budget; CI never does, so the check moves
# rather than disappearing (Annex I §12.1, §21.2).
if [ "$fast" = "yes" ]; then
  export OPANEL_FAST_TESTS=1
else
  unset OPANEL_FAST_TESTS
fi

seed_args=""
[ -n "$seed" ] && seed_args="--seed $seed"

# Freeze inputs before execution. Reports written afterwards cannot attest
# that a different tree was tested; a concurrent source edit invalidates the run.
export OPANEL_TEST_INPUT_ID
OPANEL_TEST_INPUT_ID="$(ruby -r./lib/gates/test_evidence -e 'puts Opanel::Gates::TestEvidence.identity(Dir.pwd)')" || exit 1
export OPANEL_TEST_SPEC_FILES
OPANEL_TEST_SPEC_FILES="$(ruby -r./lib/gates/test_evidence -e '
  paths = ARGV.first.to_s.split
  paths = ["spec"] if paths.empty?
  puts Opanel::Gates::TestEvidence.expand(paths, Dir.pwd).to_json
' "$paths")" || exit 1

# CI, seeded reproductions and --force always execute. The ledger retains every
# selection, so contract/probe runs cannot clobber a previously proved suite.
if [ "$force" != "yes" ] && [ -z "${CI:-}" ] && [ -z "$seed" ]; then
  if ruby -r./lib/gates/test_evidence -e '
    e = Opanel::Gates::TestEvidence
    required = JSON.parse(ENV.fetch("OPANEL_TEST_SPEC_FILES"))
    missing = e.uncovered(e.records(Dir.pwd), required,
      identity: ENV.fetch("OPANEL_TEST_INPUT_ID"), context: e.context,
      fast: ARGV[0] == "yes", parallel: (ARGV[1] == "yes" ? true : nil), fresh: true)
    exit(required.any? && missing.empty? ? 0 : 1)
  ' "$fast" "$parallel"; then
    echo "tests: already proven for these inputs and this selection — bin/test --force to run anyway"
    exit 0
  fi
fi

started="$(gate_now_ms)"

# shellcheck disable=SC2086
if [ "$parallel" = "yes" ]; then
  # One database per worker, suffixed by TEST_ENV_NUMBER — which the namespace
  # helper also reads, so two workers cannot collide on a generated name.
  run=(bundle exec parallel_test --type rspec -o "--format progress $seed_args" -- $paths)
else
  run=(bundle exec rspec --format progress $seed_args $paths)
fi

# rspec-metadata.json describes the *last* run, whatever it was, and every
# partial run overwrites it — `bin/gate local` itself runs `--type contract`
# right after the suite, so the gate erased the complete record it had just
# produced. The complete record is kept beside it, for the check that asks
# "how long does the whole suite take" rather than "what ran last"
# (spec/gates/gate_budget_spec.rb). post-commit keeps reading the last run.
keep_complete_record() {
  if ruby -rjson -e 'exit JSON.parse(File.read(ARGV[0]))["complete"] ? 0 : 1' \
      tmp/test-results/rspec-metadata.json 2>/dev/null; then
    cp tmp/test-results/rspec-metadata.json tmp/test-results/rspec-metadata-complete.json
  fi
}

if [ "$format" = "text" ]; then
  "${run[@]}"
  status=$?
  bin/test-metadata "$status" "$(( $(gate_now_ms) - started ))" "$type" "$parallel" \
    "$scope" "$fast" "$paths"
  keep_complete_record
  exit $status
fi

gate_begin "test" "$format"
gate_run "rspec" "${run[@]}"
bin/test-metadata "$GATE_FAILURES" "$(( $(gate_now_ms) - started ))" "$type" "$parallel" \
  "$scope" "$fast" "$paths" >/dev/null
keep_complete_record
gate_finish
