#!/usr/bin/env ruby
# frozen_string_literal: true

# Writes the metadata that turns a test run into release evidence (Annex D §24).
#
#   bin/test-metadata <exit-status> <duration-ms> <suite-type> <parallel?> <scope> <fast?> <paths>
#
# "the suite passed" is not evidence. Which commit, on which branch, in which
# environment, against which database, how long it took and how many examples ran
# — that is. Called by bin/test; not meant to be run by hand.
#
# **What was selected is part of the answer.** `type` alone said `all` for a run
# filtered to three files by `--changed`, for a run that dropped every `:slow`
# example with `--fast`, and for a run given explicit paths — and the Post-commit
# Gate read `all` as "every suite ran". Scope, fast and the paths are recorded
# next to it so a narrow run cannot be read as a full one.

require "json"
require "time"

status, duration_ms, suite_type, parallel, scope, fast, paths = ARGV
root = File.expand_path("..", __dir__)
Dir.chdir(root)

def git(command)
  value = `git #{command} 2>/dev/null`.strip
  value.empty? ? nil : value
end

# Summed from the JUnit reports rather than recounted, so the numbers cannot
# disagree with what the runner reported. A parallel run writes one file per
# worker, and every invocation has its own run id — a nested `bin/test` used to
# overwrite the outer run's report, which made the counts describe a different
# run than the result did.
def junit_counts(glob)
  reports = Dir.glob(glob)
  return {} if reports.empty?

  %w[tests failures errors skipped].to_h do |attribute|
    total = reports.sum do |path|
      File.read(path, 4096).to_s[/#{attribute}="(\d+)"/, 1].to_i
    end
    [ attribute, total ]
  end.merge("reports" => reports.length)
end

selected = paths.to_s.split(/\s+/).reject(&:empty?)

metadata = {
  suite: "rspec",
  type: suite_type,
  # `all` when nothing narrowed the run, and the narrowing otherwise. A consumer
  # asking "did the integration suite run?" needs both.
  scope: scope.to_s.empty? ? "all" : scope,
  fast: fast == "yes",
  selected_paths: selected,
  # The one field that answers "was this the whole suite?" without the consumer
  # having to reason about the other three.
  complete: suite_type == "all" && scope.to_s == "all" && fast != "yes" && selected.empty?,
  result: status.to_i.zero? ? "pass" : "fail",
  exit_status: status.to_i,
  duration_ms: duration_ms.to_i,
  parallel: parallel == "yes",
  environment: ENV.fetch("RAILS_ENV", "test"),
  database: ENV.fetch("OPANEL_TEST_DATABASE_NAME", "opanel_test"),
  commit: git("rev-parse HEAD"),
  branch: git("rev-parse --abbrev-ref HEAD"),
  dirty: !git("status --porcelain").nil?,
  ruby: RUBY_VERSION,
  finished_at: Time.now.utc.iso8601
}.merge(junit_counts("tmp/test-results/rspec-#{ENV.fetch('OPANEL_TEST_RUN_ID', 'adhoc')}*.xml"))

path = "tmp/test-results/rspec-metadata.json"
File.write(path, JSON.pretty_generate(metadata))
puts "test evidence: #{path} (#{metadata[:result]}, #{metadata['tests']} example(s), #{metadata[:duration_ms]}ms)"
