#!/usr/bin/env ruby
# frozen_string_literal: true

# Writes the metadata that turns a test run into release evidence (Annex D §24).
#
#   bin/test-metadata <exit-status> <duration-ms> <suite-type> <parallel?> <scope> <fast?> <paths>
#
# "the suite passed" is not evidence. Which commit, on which branch, in which
# environment, against which database, how long it took and how many examples ran
# — that is. Called by bin/test; not meant to be run by hand.
#
# **What was selected is part of the answer.** `type` alone said `all` for a run
# filtered to three files by `--changed`, for a run that dropped every `:slow`
# example with `--fast`, and for a run given explicit paths — and the Post-commit
# Gate read `all` as "every suite ran". Scope, fast and the paths are recorded
# next to it so a narrow run cannot be read as a full one.

require "json"
require "time"
require "tmpdir"
require "fileutils"
require_relative "../lib/gates/test_evidence"

status, duration_ms, suite_type, parallel, scope, fast, paths = ARGV
root = File.expand_path("..", __dir__)
Dir.chdir(root)

def git(command)
  value = `git #{command} 2>/dev/null`.strip
  value.empty? ? nil : value
end

# Summed from the JUnit reports rather than recounted, so the numbers cannot
# disagree with what the runner reported. A parallel run writes one file per
# worker, and every invocation has its own run id — a nested `bin/test` used to
# overwrite the outer run's report, which made the counts describe a different
# run than the result did.
def junit_counts(glob)
  reports = Dir.glob(glob)
  return {} if reports.empty?

  %w[tests failures errors skipped].to_h do |attribute|
    total = reports.sum do |path|
      File.read(path, 4096).to_s[/#{attribute}="(\d+)"/, 1].to_i
    end
    [ attribute, total ]
  end.merge("reports" => reports.length)
end

selected = paths.to_s.split(/\s+/).reject(&:empty?)

# The content of the **tracked** working tree, as a git tree id.
#
# This is the field a gate should compare, and `commit` is not: the pre-commit
# hook runs before the commit exists, so evidence it produces always names the
# parent, and the suite has to run again after the commit purely to make the
# recorded hash match — a third identical run per Story (M01-92). An empty
# commit or an amended message invalidates evidence that is still valid; a
# commit that changes only untracked files leaves it looking valid. The tree
# answers the actual question: did this suite run against this code?
#
# `git stash create` builds a commit over the current index and working tree
# without touching either, and without untracked files — an untracked file
# cannot make evidence look valid because it is not what gets committed. It
# returns nothing when the tree is clean, in which case HEAD's own tree is the
# answer. The same tree id the pre-commit record uses (`git write-tree` on a
# fully staged index) matches this on the commit's tree, which is what lets one
# run serve every gate stage.
# The content of everything git **could** commit — tracked files plus untracked
# files it does not ignore — as a tree id.
#
# `working_tree_id` below answers "did this suite run against this committed
# code?", which is the question the Post-commit Gate asks. This one answers a
# different question: "has this exact code already been proved?" — and for that,
# a new spec file nobody has added yet has to count, because it is code the run
# would execute. Built in a throwaway index so neither the real index nor the
# working tree is touched.
def committable_tree_id
  index = File.join(Dir.tmpdir, "opanel-test-index-#{Process.pid}")
  environment = { "GIT_INDEX_FILE" => index }
  return nil unless system(environment, "git", "read-tree", "HEAD", out: File::NULL, err: File::NULL)

  return nil unless system(environment, "git", "add", "-A", out: File::NULL, err: File::NULL)

  id = IO.popen(environment, [ "git", "write-tree" ], &:read).to_s.strip
  id.empty? ? nil : id
ensure
  FileUtils.rm_f(index)
end

def working_tree_id
  snapshot = git("stash create")
  return git("rev-parse #{snapshot}^{tree}") if snapshot

  git("rev-parse HEAD^{tree}")
end

# `bin/test` asks for the identity before deciding whether to run at all.
if ARGV.first == "--identity"
  puts committable_tree_id
  exit 0
end

evidence = Opanel::Gates::TestEvidence
metadata = {
  suite: "rspec",
  input_identity: ENV["OPANEL_TEST_INPUT_ID"],
  inputs_stable: ENV["OPANEL_TEST_INPUT_ID"] == evidence.identity(root),
  context: evidence.context,
  spec_files: JSON.parse(ENV.fetch("OPANEL_TEST_SPEC_FILES", "[]")),
  type: suite_type,
  # `all` when nothing narrowed the run, and the narrowing otherwise. A consumer
  # asking "did the integration suite run?" needs both.
  scope: scope.to_s.empty? ? "all" : scope,
  fast: fast == "yes",
  selected_paths: selected,
  # The one field that answers "was this the whole suite?" without the consumer
  # having to reason about the other three.
  complete: suite_type == "all" && scope.to_s == "all" && fast != "yes" && selected.empty?,
  result: status.to_i.zero? ? "pass" : "fail",
  exit_status: status.to_i,
  duration_ms: duration_ms.to_i,
  parallel: parallel == "yes",
  environment: ENV.fetch("RAILS_ENV", "test"),
  database: ENV.fetch("OPANEL_TEST_DATABASE_NAME", "opanel_test"),
  commit: git("rev-parse HEAD"),
  tree: working_tree_id,
  # Identity for "already proved", not for "matches the commit". See above.
  committable_tree: committable_tree_id,
  branch: git("rev-parse --abbrev-ref HEAD"),
  dirty: !git("status --porcelain").nil?,
  ruby: RUBY_VERSION,
  finished_at: Time.now.utc.iso8601(6)
}.merge(junit_counts("tmp/test-results/rspec-#{ENV.fetch('OPANEL_TEST_RUN_ID', 'adhoc')}*.xml"))

path = "tmp/test-results/rspec-metadata.json"
evidence.write(path, metadata)
if ENV["OPANEL_TEST_RUN_ID"]
  evidence.write("tmp/test-results/runs/#{ENV.fetch("OPANEL_TEST_RUN_ID")}.json", metadata)
end
evidence.write("tmp/test-results/rspec-metadata-complete.json", metadata) if metadata[:complete]
puts "test evidence: #{path} (#{metadata[:result]}, #{metadata['tests']} example(s), #{metadata[:duration_ms]}ms)"
