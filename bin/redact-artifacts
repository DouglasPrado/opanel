#!/usr/bin/env ruby
# frozen_string_literal: true

# Redacts test failure artifacts before they are archived (Annex C §17.1).
#
#   bin/redact-artifacts tmp/test-results
#   bin/redact-artifacts --format json tmp/test-results
#
# A trace, a screenshot and a video record whatever was on screen and on the wire.
# That is why they are useful and why they cannot be uploaded unexamined: an
# Authorization header, a session cookie or a revealed secret would be published
# to CI storage and to whoever has the artifact link.
#
# Three dispositions, and the third is the one that matters:
#
#   * **Text** is masked in place.
#   * **An archive** is opened and every entry is inspected. A Playwright trace is
#     a ZIP whose JSON is DEFLATE-compressed, so grepping the container's bytes
#     found nothing and reported the artifact clean — which is how a recoverable
#     credential passed this check. Reading the container is not inspecting it.
#   * **Anything that cannot be inspected** is refused. Not knowing what is inside
#     an artifact is not the same as knowing it is clean, so an unreadable
#     archive, an unknown binary format or a corrupt entry is deleted and the
#     command exits non-zero. Losing a diagnostic is recoverable; publishing a
#     credential is not.

require "digest"
require "json"
require "fileutils"
require "set"
require "stringio"
require "zlib"

PATTERNS = {
  "authorization-header" => /(authorization"?\s*[:=]\s*"?)(Bearer|Basic|Token)\s+[A-Za-z0-9._\-\/+=]+/i,
  # The same header, as a trace actually stores it. Playwright writes each one as
  # `{"name":"authorization","value":"Bearer …"}`, so the name and the value are
  # separated by the whole JSON encoding and the line-oriented pattern above
  # never reaches across it. This is the shape inside the archive, which is the
  # only place these headers appear at all.
  "header-object" => /("name"\s*:\s*"(?:authorization|proxy-authorization|cookie|set-cookie|x-api-key|x-auth-token)"\s*,\s*"value"\s*:\s*")([^"\r\n]{8,})/i,
  "cookie-header" => /((?:set-)?cookie"?\s*[:=]\s*"?)([^"\r\n;]{8,})/i,
  "password-assignment" => /((?:password|passwd|pwd|secret|passphrase)"?\s*[:=]\s*"?)([^"\s,}]{4,})/i,
  "token-assignment" => /((?:api[_-]?key|token|access[_-]?token|refresh[_-]?token)"?\s*[:=]\s*"?)([A-Za-z0-9._\-]{12,})/i,
  "connection-url" => %r{([a-z][a-z0-9+.\-]*://[^\s:/@"]+:)([^\s@"]{3,})(@)}i,
  "private-key" => /-----BEGIN [A-Z ]*PRIVATE KEY-----/,
  "recovery-key" => /(recovery[_-]?key"?\s*[:=]\s*"?)([^"\s,}]{4,})/i
}.freeze

# `.jsonl` is here because this repository writes one: VISUAL_MANIFEST below. It
# was missing, and a manifest with entries only passed by accident — the sniff
# below reads it as text. An empty one has nothing to sniff, so it was classified
# `uninspectable-format (.jsonl)`, deleted, and failed the `e2e-critical` job on
# the first real run of the pipeline. It is a text format either way.
TEXT_EXTENSIONS = %w[.txt .log .json .jsonl .xml .html .md .yml .yaml .csv .har].freeze

# Containers this tool knows how to open. A Playwright trace and its resource
# bundles are ZIP; a coverage or JUnit upload is sometimes gzip.
ARCHIVE_EXTENSIONS = %w[.zip .trace .jar .gz .tgz].freeze

# Content whose meaning is in its pixels, not in its bytes.
#
# These were published after a regex over the container: the scan found nothing,
# because there is nothing there to find. A revealed secret, a token in a field
# or a session id in a debug panel is *rendered* — no pattern above can reach it,
# and "the scanner found nothing" was recorded as "the artifact is clean".
#
# So the rule is provenance, not inspection. A visual artifact is published only
# when it appears in the capture manifest with a matching digest: that is, only
# when it came out of a browser context e2e/support/masked-capture.ts had already
# masked. Anything else is deleted. Inside an archive, where a per-file manifest
# entry does not exist, the entry is **covered** — replaced with a placeholder —
# so the trace stays navigable and its frames carry nothing.
VISUAL = %w[.png .jpg .jpeg .gif .webp .webm .mp4 .avif].freeze

# Opaque, but not a recording of a screen: a font or an icon carries no session.
# Still scanned for the patterns above, which catches a credential embedded in
# metadata.
#
# **Anything not listed here and not readable is deleted.** Adding an extension
# is widening what gets published unexamined, so it needs a Story that says why.
INERT_OPAQUE = %w[.ico .woff .woff2 .ttf .pdf].freeze

PUBLISHABLE_OPAQUE = (VISUAL + INERT_OPAQUE).freeze

# Written per attachment by e2e/support/masked-capture.ts, as JSON lines.
VISUAL_MANIFEST = "tmp/test-results/visual-manifest.jsonl"

# What a covered entry is replaced with. A 1×1 transparent PNG: the trace viewer
# still renders a frame, and the frame is empty.
PLACEHOLDER_PNG = [
  "89504e470d0a1a0a0000000d4948445200000001000000010806000000" \
  "1f15c4890000000d4944415478da63fcffff3f0300050001ff9c5fa6dd" \
  "0000000049454e44ae426082"
].pack("H*").freeze

MASKED = "[REDACTED]"

# The container was recognised but could not be read. Fails closed.
class Unreadable < StandardError; end

format = "text"
roots = []
arguments = ARGV.dup

until arguments.empty?
  argument = arguments.shift

  case argument
  when "--json" then format = "json"
  when "--format" then format = arguments.shift
  when /\A--format=(.+)\z/ then format = Regexp.last_match(1)
  when /\A--/
    warn "unknown option: #{argument}"
    exit 2
  else
    roots << argument
  end
end

roots = %w[tmp/test-results playwright-report test-results] if roots.empty?

def binary_read(path)
  File.read(path, encoding: "BINARY")
end

def to_text(bytes)
  bytes.to_s.dup.force_encoding("BINARY").encode("UTF-8", invalid: :replace, undef: :replace, replace: "")
end

def text_artifact?(path)
  return true if TEXT_EXTENSIONS.include?(File.extname(path).downcase)
  return false if ARCHIVE_EXTENSIONS.include?(File.extname(path).downcase)
  return false if PUBLISHABLE_OPAQUE.include?(File.extname(path).downcase)

  sample = File.read(path, 4096, mode: "rb").to_s

  # Zero bytes carry nothing, so there is nothing to clear. This read `!empty?`,
  # which sent every empty file down the binary path to be deleted as
  # uninspectable — "nobody could read it" applied to a file with nothing in it.
  # The three guards above still run first, so an empty .png is still an unproven
  # visual artifact and an empty .zip is still an archive nobody could open.
  return true if sample.empty?

  sample.valid_encoding? && !sample.include?("\u0000")
rescue SystemCallError
  false
end

def scan(content)
  PATTERNS.select { |_name, pattern| content.match?(pattern) }.keys
end

def mask(content)
  PATTERNS.each_value.reduce(content) do |text, pattern|
    text.gsub(pattern) do
      match = Regexp.last_match
      if match.captures.length >= 2
        "#{match[1]}#{MASKED}#{match[3]}"
      else
        MASKED
      end
    end
  end
end

# --- Archives ----------------------------------------------------------------
#
# The ZIP central directory rather than the local headers: a streamed entry puts
# its sizes in a trailing data descriptor, so the local header alone does not say
# how many bytes to read. The central directory always does.

ZIP_END_OF_CENTRAL_DIRECTORY = "PK\x05\x06".b
ZIP_CENTRAL_FILE_HEADER = "PK\x01\x02".b
ZIP_LOCAL_FILE_HEADER = "PK\x03\x04".b
ZIP64_MARKER = 0xFFFFFFFF

STORED = 0
DEFLATED = 8

def zip?(bytes) = bytes.start_with?(ZIP_LOCAL_FILE_HEADER)
def gzip?(bytes) = bytes.start_with?("\x1F\x8B".b)

def zip_entries(bytes)
  eocd = bytes.rindex(ZIP_END_OF_CENTRAL_DIRECTORY)
  raise Unreadable, "no end-of-central-directory record" if eocd.nil?

  count = bytes[eocd + 10, 2].to_s.unpack1("v")
  offset = bytes[eocd + 16, 4].to_s.unpack1("V")
  raise Unreadable, "unreadable central directory" if count.nil? || offset.nil?
  raise Unreadable, "ZIP64 archives are not inspected" if offset == ZIP64_MARKER

  entries = []
  cursor = offset

  count.times do
    unless bytes[cursor, 4] == ZIP_CENTRAL_FILE_HEADER && bytes.bytesize >= cursor + 46
      raise Unreadable, "central directory record is truncated"
    end

    method = bytes[cursor + 10, 2].unpack1("v")
    compressed_size = bytes[cursor + 20, 4].unpack1("V")
    name_length = bytes[cursor + 28, 2].unpack1("v")
    extra_length = bytes[cursor + 30, 2].unpack1("v")
    comment_length = bytes[cursor + 32, 2].unpack1("v")
    local_offset = bytes[cursor + 42, 4].unpack1("V")
    name = bytes[cursor + 46, name_length].to_s

    if [ compressed_size, local_offset ].include?(ZIP64_MARKER)
      raise Unreadable, "ZIP64 entry #{name} is not inspected"
    end

    entries << { name: name, method: method, compressed_size: compressed_size, offset: local_offset }
    cursor += 46 + name_length + extra_length + comment_length
  end

  entries
end

# A ZIP entry holds a raw DEFLATE stream, without the zlib header
# `Zlib::Inflate.inflate` expects — hence the negative window size. The stream is
# in memory and holds no descriptor, so it is left to the collector rather than
# closed in an `ensure` that would have to swallow its own failure.
def inflate_raw(data)
  Zlib::Inflate.new(-Zlib::MAX_WBITS).inflate(data)
end

def zip_entry_content(bytes, entry)
  header = entry[:offset]
  raise Unreadable, "local header of #{entry[:name]} is missing" unless bytes[header, 4] == ZIP_LOCAL_FILE_HEADER

  name_length = bytes[header + 26, 2].unpack1("v")
  extra_length = bytes[header + 28, 2].unpack1("v")
  data = bytes[header + 30 + name_length + extra_length, entry[:compressed_size]].to_s

  case entry[:method]
  when STORED then data
  when DEFLATED then inflate_raw(data)
  else raise Unreadable, "#{entry[:name]} uses compression method #{entry[:method]}"
  end
rescue Zlib::Error => error
  raise Unreadable, "#{entry[:name]} could not be decompressed: #{error.class}"
end

# Every entry, decompressed. Nested archives are opened too — a trace bundles
# resource archives, and one level of nesting would otherwise be a blind spot.
def archive_contents(bytes, depth: 0)
  raise Unreadable, "archive nesting is deeper than 3 levels" if depth > 3

  if gzip?(bytes)
    inflated = Zlib::GzipReader.new(StringIO.new(bytes)).read
    return [ inflated ] + (zip?(inflated) ? archive_contents(inflated, depth: depth + 1) : [])
  end

  raise Unreadable, "not a ZIP or gzip container" unless zip?(bytes)

  zip_entries(bytes).flat_map do |entry|
    content = zip_entry_content(bytes, entry)
    nested = zip?(content) || gzip?(content) ? archive_contents(content, depth: depth + 1) : []
    [ content ] + nested
  end
rescue Zlib::Error => error
  raise Unreadable, "could not be decompressed: #{error.class}"
end

# --- Covering visual entries inside an archive --------------------------------
#
# A Playwright trace bundles the screencast frames as `resources/*.png` and
# `*.jpeg`. Scanning them finds nothing — they are pixels — so the trace was
# published with whatever was on screen inside it. The entries are replaced and
# the archive is rewritten, which keeps the actions, the network log and the
# console output a trace exists for.

PNG_MAGIC = "\x89PNG".b
JPEG_MAGIC = "\xFF\xD8\xFF".b
GIF_MAGIC = "GIF8".b
WEBP_MAGIC = "RIFF".b

def visual_entry?(name, content)
  return true if VISUAL.include?(File.extname(name).downcase)

  content.start_with?(PNG_MAGIC, JPEG_MAGIC, GIF_MAGIC) ||
    (content.start_with?(WEBP_MAGIC) && content[8, 4] == "WEBP".b)
end

# A minimal ZIP: every entry stored, no data descriptor. Playwright's own reader
# accepts it, and writing STORED avoids re-deriving compressed sizes.
def build_zip(entries)
  local = +"".b
  central = +"".b

  entries.each do |name, content|
    offset = local.bytesize
    crc = Zlib.crc32(content)
    common = [ 20, 0, STORED, 0, 0, crc, content.bytesize, content.bytesize, name.bytesize, 0 ]

    local << ZIP_LOCAL_FILE_HEADER << common.pack("vvvvvVVVvv") << name.b << content
    # After the shared 26 bytes: comment length, disk number, internal and
    # external attributes, and the local header's offset — 46 bytes in total
    # before the name, which is what zip_entries above reads back.
    central << ZIP_CENTRAL_FILE_HEADER << [ 20 ].pack("v") << common.pack("vvvvvVVVvv") <<
      [ 0, 0, 0, 0, offset ].pack("vvvVV") << name.b
  end

  local + central + ZIP_END_OF_CENTRAL_DIRECTORY +
    [ 0, 0, entries.length, entries.length, central.bytesize, local.bytesize, 0 ].pack("vvvvVVv")
end

# Returns [rewritten_bytes_or_nil, covered_entry_names].
def cover_visual_entries(bytes)
  return [ nil, [] ] unless zip?(bytes)

  covered = []
  entries = zip_entries(bytes).map do |entry|
    content = zip_entry_content(bytes, entry)

    if visual_entry?(entry[:name], content)
      covered << entry[:name]
      [ entry[:name], PLACEHOLDER_PNG ]
    else
      [ entry[:name], content ]
    end
  end

  covered.empty? ? [ nil, [] ] : [ build_zip(entries), covered ]
end

# --- Provenance of a standalone visual artifact -------------------------------

# Where the harness may have left it: the default path, or beside the artifacts
# it describes — `bin/redact-artifacts` is given the output directory, and the
# manifest sits with the run that produced it.
def manifest_paths(roots)
  ([ VISUAL_MANIFEST ] +
    roots.flat_map do |root|
      [ File.join(root, File.basename(VISUAL_MANIFEST)),
        File.join(File.dirname(root), File.basename(VISUAL_MANIFEST)) ]
    end).uniq
end

def capture_manifest(roots)
  @capture_manifest ||= manifest_paths(roots).each_with_object(Set.new) do |path, digests|
    next unless File.file?(path)

    File.foreach(path) do |line|
      digests << JSON.parse(line)["sha256"]
    rescue JSON::ParserError
      next
    end
  end
end

def captured_masked?(path, roots)
  capture_manifest(roots).include?(Digest::SHA256.file(path).hexdigest)
end

# --- Walk --------------------------------------------------------------------

masked = []
deleted = []
covered = []
scanned = 0

roots.each do |root|
  next unless Dir.exist?(root)

  Dir.glob(File.join(root, "**", "*")).each do |path|
    next unless File.file?(path)

    scanned += 1
    extension = File.extname(path).downcase

    if text_artifact?(path)
      content = to_text(binary_read(path))
      findings = scan(content)
      next if findings.empty?

      File.write(path, mask(content))
      masked << { file: path, patterns: findings }
      next
    end

    bytes = binary_read(path)
    findings = scan(to_text(bytes))

    if ARCHIVE_EXTENSIONS.include?(extension) || zip?(bytes) || gzip?(bytes)
      begin
        archive_contents(bytes).each { |entry| findings.concat(scan(to_text(entry))) }

        # Whatever the text scan concluded, the frames inside are pixels and were
        # never examined by it. They are replaced rather than the archive being
        # deleted: a trace with blank frames is still a navigable trace.
        rewritten, entries = cover_visual_entries(bytes)
        if rewritten
          File.binwrite(path, rewritten)
          covered << { file: path, entries: entries }
        end
      rescue Unreadable => error
        # An archive nobody could open is an archive nobody has cleared.
        findings << "uninspectable-archive (#{error.message})"
      end
    elsif VISUAL.include?(extension)
      # Provenance, because inspection is not available here. Only a recording
      # made in a context e2e/support/masked-capture.ts had masked may be
      # published; an image that appeared by any other route has nothing
      # vouching for what is in it.
      unless captured_masked?(path, roots)
        findings << "unproven-visual-artifact (no #{File.basename(VISUAL_MANIFEST)} entry)"
      end
    elsif !INERT_OPAQUE.include?(extension)
      findings << "uninspectable-format (#{extension.empty? ? 'no extension' : extension})"
    end

    findings = findings.uniq
    next if findings.empty?

    FileUtils.rm_f(path)
    deleted << { file: path, patterns: findings }
  end
end

result = deleted.empty? ? "pass" : "fail"

if format == "json"
  puts JSON.pretty_generate(
    check: "redact-artifacts",
    result: result,
    files_scanned: scanned,
    masked: masked,
    covered: covered,
    deleted: deleted
  )
else
  masked.each { |entry| puts "redact-artifacts: masked #{entry[:file]} (#{entry[:patterns].join(', ')})" }
  covered.each do |entry|
    puts "redact-artifacts: covered #{entry[:entries].length} visual entr(ies) in #{entry[:file]}"
  end
  deleted.each { |entry| puts "redact-artifacts: DELETED #{entry[:file]} (#{entry[:patterns].join(', ')})" }

  if deleted.empty?
    puts "redact-artifacts: PASS (#{scanned} artifact(s), #{masked.length} masked, " \
         "#{covered.sum { |entry| entry[:entries].length }} visual entr(ies) covered)"
  else
    puts "redact-artifacts: FAIL — #{deleted.length} artifact(s) could not be cleared and were removed"
  end
end

exit(deleted.empty? ? 0 : 1)
